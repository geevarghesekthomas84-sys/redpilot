# RedPilot deploy configuration — copy to .env and edit. Do NOT commit the real .env.

# ── Required ─────────────────────────────────────────────────────────
# Comma-separated API keys accepted by the API (generate strong random values).
REDPILOT_API_KEYS=change-me-to-a-long-random-key

# ── Gateway / TLS ────────────────────────────────────────────────────
# Public domain for automatic Let's Encrypt TLS. Leave as localhost for a
# local internal-CA cert (dev). A real domain requires REDPILOT_ACME_EMAIL.
REDPILOT_DOMAIN=localhost
REDPILOT_ACME_EMAIL=

# ── Database ─────────────────────────────────────────────────────────
# sqlite (default, zero-setup) or mongo (run with: --profile mongo)
REDPILOT_DB_BACKEND=sqlite
REDPILOT_MONGO_URI=mongodb://mongo:27017

# ── AI (optional) ────────────────────────────────────────────────────
AI_PROVIDER=google
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# ── Multi-engagement & RBAC (optional) ───────────────────────────────
# Map API keys to roles (viewer|operator|lead) and allowed engagements.
# Unset => REDPILOT_API_KEYS act as all-access leads (RBAC off). Example:
# REDPILOT_PRINCIPALS={"LEAD_KEY":{"role":"lead","engagements":["*"]},"OP_KEY":{"role":"operator","engagements":["acme-corp"]}}
REDPILOT_PRINCIPALS=
# Signing key for tamper-evident engagement authorizations (set to require
# a valid signature before active runs on a persisted engagement).
REDPILOT_AUTH_SIGNING_KEY=
